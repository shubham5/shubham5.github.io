---
const year = new Date().getFullYear();
---

<footer>
  <div>&copy; {year} Shubham</div>
  <div class="links">
    <a href="https://twitter.com/notaquizzer" rel="me noopener">Twitter</a>
    <a href="https://github.com/shubham5" rel="me noopener">GitHub</a>
    <a href="mailto:skshubham4@gmail.com">Email</a>
  </div>
</footer>

<style>
  footer {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.25rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.875rem;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  .links a {
    color: var(--color-muted);
    border-bottom: none;
  }
  .links a:hover {
    color: var(--color-text);
  }
</style>
