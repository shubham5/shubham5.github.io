---
import Base from '../../layouts/Base.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('writings');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'writings'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, description, tags } = entry.data;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${title} — Shubham`} description={description}>
  <article>
    <header>
      <h1>{title}</h1>
      <div class="muted small">{formattedDate}</div>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      )}
    </header>
    <Content />
  </article>
  <p class="muted small"><a href="/writings">← All writings</a></p>
</Base>

<style>
  header {
    margin-bottom: 1.5rem;
  }
  header h1 {
    margin-bottom: 0.25rem;
  }
  .tags {
    margin-top: 0.5rem;
  }
</style>
